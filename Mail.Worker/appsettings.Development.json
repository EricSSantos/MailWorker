{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Application": {
    "ResetPasswordUrl": "<APPLICATION_RESET_PASSWORD_URL>"
  },
  "Smtp": {
    "Host": "<SMTP_HOST>",
    "Port": 587,
    "User": "<SMTP_USER>",
    "Password": "<SMTP_PASSWORD>",
    "FromEmail": "<SMTP_FROM_EMAIL>",
    "FromName": "<SMTP_FROM_NAME>",
    "EnableSsl": true
  },
  "RabbitMQ": {
    "Host": "<RABBITMQ_HOST>",
    "Port": 5672,
    "User": "<RABBITMQ_USER>",
    "Password": "<RABBITMQ_PASSWORD>",
    "EmailQueue": "<RABBITMQ_EMAIL_QUEUE>",
    "DeadLetterQueue": "<RABBITMQ_DEADLETTER_QUEUE>"
  }
}
